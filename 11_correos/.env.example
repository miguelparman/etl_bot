# Copiar a '.env' y completar con los valores reales. No versionar '.env'.

# ---------------------------------------------------------------------------
# Microsoft Entra ID / Graph -- 'BPO' (origen) y 'ReportingFractalia' (destino)
# son TENANTS DISTINTOS, cada uno con su propio App Registration (client
# credentials): NO se puede usar el mismo TENANT_ID/CLIENT_ID/CLIENT_SECRET
# para ambos. Mismas credenciales que usa 02_ventas/copiar_funnel_ventas.py
# para el mismo par de tenants.
# ---------------------------------------------------------------------------

# --- Tenant/App Registration de 'BPO' (origen, permiso Sites.Selected sobre
# /sites/BPO). El site tiene un unico drive ('Documentos compartidos'), se
# resuelve automaticamente. Solo se copian los .xlsx del nivel raiz de la
# carpeta indicada (no se recorre 'Macros_Coordinadores' ni otras subcarpetas). ---
SOURCE_TENANT_ID=
SOURCE_CLIENT_ID=
SOURCE_CLIENT_SECRET=
SOURCE_GRAPH_TIMEOUT=120000
SOURCE_SHAREPOINT_HOSTNAME=fractaliagroup.sharepoint.com
SOURCE_SHAREPOINT_SITE_PATH=/sites/BPO
SOURCE_SHAREPOINT_FOLDER_PATH=Control Correos Chile

# --- Tenant/App Registration de 'ReportingFractalia' (destino, permiso
# Sites.Selected sobre ese sitio). ---
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
GRAPH_TIMEOUT=120000
SHAREPOINT_HOSTNAME=fractaliagroup.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/ReportingFractalia
SHAREPOINT_DRIVE_NAME=Data Reporting
SHAREPOINT_FOLDER_PATH=REPOSITORIOS DE CRUDOS/CHILE/BPOCHIPE/14 CORREOS

# ---------------------------------------------------------------------------
# SQL Server 'CL_MOVIL' (172.17.0.162), destino de cargar_correos.py
# (TBL_CORREO_REGISTRO / TBL_CORREO_BANDEJAS -- ver infra/sql/02_create_tables.sql,
# correrlo una vez antes de la primera carga). No lo necesitan main.py ni
# verificar_copia.py.
# ---------------------------------------------------------------------------
DB_SERVER=172.17.0.162
DB_NAME=CL_MOVIL
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
BATCH_SIZE=5000

# --- Periodo de carga de TBL_CORREO_REGISTRO (UTC ISO-8601, sobre
# FechaHora_UTC_Texto -- inicio inclusivo, fin exclusivo). Permite correr
# cargar_correos.py sin argumentos (util para un schedule automatizado).
# Puede sobreescribirse puntualmente con --fecha-inicio/--fecha-fin. ---
FECHA_INICIO=
FECHA_FIN=
