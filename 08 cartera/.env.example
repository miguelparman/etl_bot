# Copiar a '.env' y completar con los valores reales. No versionar '.env'.

# --- SQL Server (mismo servidor, 2 bases de datos -- Connection Managers
# 'PEOPEDESK0328.CL_CARTERA' y 'PEOPEDESK0328.CL_TEMPORALES' en el .dtsx
# original). Las credenciales alli estaban encriptadas por usuario/maquina
# (DPAPI) y no son reutilizables fuera de esa maquina: deben completarse de
# nuevo aqui, nunca embeberse en el codigo.
DB_SERVER=172.17.0.162
DB_USER=mparedes
DB_PASSWORD=
DB_NAME_CARTERA=CL_CARTERA
DB_NAME_TEMPORALES=CL_TEMPORALES
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# Nota: el proceso tambien lee, via consulta cross-database de solo lectura,
# [CL_DATA].[dbo].[TBL_PLACES] (maestro de asesores/ejecutivos) desde la
# conexion de CL_TEMPORALES. Debe existir en el MISMO servidor y el usuario
# de arriba debe tener permiso de lectura sobre esa base de datos.

# --- Excel de origen (Connection Manager 'CARTERA' en el .dtsx original) ---
EXCEL_PATH=D:\IRISCENE ENGINEERING CORPORATION SLU\BPO - Insumos\Chile\CARTERA\CARTERA_FRACTALIA.xlsx

# --- Periodo de cartera vigente (variable de paquete User::Fecha_Inicio) ---
# En el .dtsx original era un valor LITERAL fijo escrito a mano en la
# expresion de la variable (no una formula): se editaba antes de cada
# corrida para marcar el inicio del periodo vigente. Formato YYYYMMDD.
# Puede sobreescribirse puntualmente con --fecha-inicio en la CLI.
VAR_FECHA_INICIO=

# Tamano de lote para las inserciones (equivalente a ROWS_PER_BATCH del FastLoad).
BATCH_SIZE=5000
