# Copiar a '.env' y completar con los valores reales. No versionar '.env'.

# Las tablas a copiar (que pueden ser de bases de datos distintas) se indican
# en mappings.py o con '--tabla' al ejecutar main.py, como ruta completa
# '[BASE].[schema].[tabla]'. *_DB_NAME de abajo es solo la base de datos
# inicial de la conexion (requerida por SQL Server para conectar); el
# usuario debe tener permisos de lectura/escritura sobre todas las bases
# involucradas en ese servidor, no solo sobre la indicada aqui.

# --- Servidor origen: SQL Server 172.17.0.162, autenticacion SQL Server ---
ORIGEN_DB_SERVER=172.17.0.162
ORIGEN_DB_NAME=CL_CARTERA
ORIGEN_DB_USER=mparedes
ORIGEN_DB_PASSWORD=

# --- Servidor destino: SQL Server local. Por defecto usa autenticacion
# Windows integrada (Trusted_Connection), es decir no requiere usuario ni
# password: el proceso corre bajo tu cuenta de Windows. Si tu instancia local
# usa autenticacion SQL Server, completa DESTINO_DB_USER/DESTINO_DB_PASSWORD.
# Cada base de datos destino (p.ej. CL_CARTERA) debe existir de antemano en
# el servidor local; el proceso no las crea automaticamente. ---
DESTINO_DB_SERVER=localhost
DESTINO_DB_NAME=CL_CARTERA
DESTINO_DB_USER=
DESTINO_DB_PASSWORD=

DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# Tamano de lote para las inserciones.
BATCH_SIZE=5000
