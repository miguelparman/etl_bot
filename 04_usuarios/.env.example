# Copiar a '.env' y completar con los valores reales. No versionar '.env'.

# --- SQL Server 'CL_USUARIOS' (172.17.0.162) -- Connection Manager
# 'LocalHost.CL_USUARIOS' / '162.CL_USUARIOS' en los .dtsx originales,
# autenticacion SQL Server (usuario 'mparedes'). La contrasena alli estaba
# encriptada por usuario/maquina (DPAPI) y no es reutilizable fuera de esa
# maquina: debe completarse de nuevo aqui, nunca embeberse en el codigo.
CL_USUARIOS_DB_SERVER=172.17.0.162
CL_USUARIOS_DB_NAME=CL_USUARIOS
CL_USUARIOS_DB_USER=mparedes
CL_USUARIOS_DB_PASSWORD=

# Nota: varias tareas SQL de este proceso hacen referencias cross-database de
# 3 partes contra el MISMO servidor (172.17.0.162): [SERVICIOS_GENERALES]
# (UDFs de fecha/dias habiles y limpieza XML) y [CL_DATA] (vista de usuarios).
# El usuario de arriba debe tener permiso de lectura/ejecucion sobre ambas.

# --- SQL Server 'Externos_Frac' (sqlclu01lis01.tchile.local) -- Connection
# Manager '223.Externos_Frac...' en los .dtsx originales, autenticacion de
# Windows integrada (SSPI): el proceso debe correr bajo una cuenta de dominio
# con acceso de lectura/escritura a esta base. No requiere usuario/password.
EXTERNOS_FRAC_DB_SERVER=sqlclu01lis01.tchile.local
EXTERNOS_FRAC_DB_NAME=Externos_Frac

DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# --- Periodo de proceso (variable de paquete User::Periodo / User::Periodo01) ---
# En los .dtsx originales era un valor LITERAL fijo escrito a mano en la
# expresion de la variable (no una formula, p.ej. '202608'): se editaba antes
# de cada corrida. Formato YYYYMM. Puede sobreescribirse puntualmente con
# --periodo en la CLI.
PERIODO=

# Tamano de lote para las inserciones (equivalente a ROWS_PER_BATCH del FastLoad).
BATCH_SIZE=5000
