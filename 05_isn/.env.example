# Copiar este archivo a ".env" y completar con valores reales.
# NUNCA versionar el archivo ".env" (ver .gitignore).

# --- SQL Server ---
# El paquete original usaba dos Connection Managers OLE DB apuntando al MISMO
# servidor (172.17.0.162 en el .dtsx original) con Initial Catalog distinto
# (CL_CALIDAD y CL_ISN). Todas las consultas usan nombres de 3 partes
# ([BASE].[dbo].[Tabla]) para cruzar tambien CL_ANALISIS, CL_VISTAS, CL_CARTERA,
# CL_CAMPAÑAS y BBDD_GENERAL, por lo que basta con UNA sola conexion cuyo login
# tenga permisos en las 7 bases.
DB_SERVER=<REDACTED_SQL_SERVER_HOST_OR_IP>
DB_PORT=1433
DB_DATABASE=CL_ISN
DB_USER=<REDACTED_SQL_LOGIN>
DB_PASSWORD=<REDACTED>
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no

# --- Rutas de archivos (equivalentes a los Connection Managers de archivo) ---
# Carpeta raiz equivalente al Connection Manager "Automatizado"
ISN_AUTOMATIZADO_DIR=D:\OneDrive - IRISCENE ENGINEERING CORPORATION SLU\ISN\Automatizado
# CSV de insumo "aux cliente" / "aux contacto" (variantes _v2 usadas por el paquete)
ISN_AUX_CLIENTE_CSV=D:\IRISCENE ENGINEERING CORPORATION SLU\BPO - Insumos\Chile\ISN\Aux_cliente\Reporte_isn_aux_cliente_v2.csv
ISN_AUX_CONTACTO_CSV=D:\IRISCENE ENGINEERING CORPORATION SLU\BPO - Insumos\Chile\ISN\Aux_contacto\Reporte_isn_aux_contacto_v2.csv

# --- Ventana de fechas (variables User::Fecha_inicio / User::Fecha_fin en el .dtsx original) ---
# En el paquete original eran valores FIJOS grabados en el diseñador, no una
# expresion dinamica. Se recomienda dejarlos vacios aqui y pasar --fecha-inicio /
# --fecha-fin por linea de comandos, o fijar un rango por defecto explicito.
# Si se dejan vacios, main.py usa "ayer" como default (ver README, seccion Riesgos).
FECHA_INICIO=
FECHA_FIN=

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs
