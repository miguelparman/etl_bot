DB_SERVER=172.17.0.162
DB_USER=mparedes
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server

DB_DATABASE_ANALISIS=CL_ANALISIS
DB_DATABASE_ISN=CL_ISN
DB_DATABASE_CALIDAD=CL_CALIDAD

CSV_CONTACTOS_PATH=/ruta/local/Reporte_Contactos_Salesforce_BI.csv
CSV_CONTACTOS_ENCODING=cp1252
CSV_CONTACTOS_DELIMITER=,

CSV_ISN_PATH=/ruta/local/isn.csv
CSV_ISN_AUX_CLIENTE_PATH=/ruta/local/Reporte_isn_aux_cliente.csv
CSV_ISN_AUX_CONTACTO_PATH=/ruta/local/Reporte_isn_aux_contacto.csv
CSV_ISN_ENCODING=cp1252

ISN_ARCHIVE_DIR=/ruta/local/Automatizado
# "copy" (default, no destructivo) o "move" -- ver README sobre la
# ambigüedad del FileSystemTask "Cambiar nombre archivo" original.
ISN_ARCHIVE_OPERATION=copy

# Rango evaluado en TBL_ISN_SF (User::Fecha_inicio / User::Fecha_fin). Si se
# omiten, por defecto es el día anterior a hoy.
FECHA_INICIO=
FECHA_FIN=
