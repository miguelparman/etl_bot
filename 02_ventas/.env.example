# Copiar a '.env' y completar con los valores reales. No versionar '.env'.

# --- SQL Server (destino, Connection Manager 'CL_USUARIOS' en ambos .dtsx
# originales -- '162.CL_DATA' esta declarado en CROSS 0102 SSIS_CL_Ventas
# pero ningun componente lo usa, no se necesita configurar) ---
DB_SERVER=172.17.0.162
DB_USER=mparedes
DB_PASSWORD=
DB_NAME=CL_USUARIOS
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# ---------------------------------------------------------------------------
# Microsoft Entra ID / Graph -- 'ReportingFractalia' y 'BPO' son TENANTS
# DISTINTOS, cada uno con su propio App Registration (client credentials):
# NO se puede usar el mismo TENANT_ID/CLIENT_ID/CLIENT_SECRET para ambos.
# Reemplaza a los archivos de red local / descarga de Google Drive de los
# .dtsx originales -- ver README, "Alcance de origenes".
# ---------------------------------------------------------------------------

# --- Tenant/App Registration de 'ReportingFractalia' (permiso Sites.Selected
# sobre ese sitio). Usado por main.py (lee '07 CROSS') y por
# copiar_funnel_ventas.py (sube el Excel a '07 CROSS'). ---
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
GRAPH_TIMEOUT=120000

SHAREPOINT_HOSTNAME=fractaliagroup.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/ReportingFractalia
SHAREPOINT_DRIVE_NAME=Data Reporting
SHAREPOINT_FOLDER_PATH=REPOSITORIOS DE CRUDOS/CHILE/BPOCHIPE/07 CROSS

# --- Tenant/App Registration de 'BPO' (permiso Sites.Selected sobre ese
# sitio -- credenciales DISTINTAS a las de arriba). Usado unicamente por
# copiar_funnel_ventas.py (paso 0, no se corre desde main.py) para descargar
# 'FUNNEL VENTAS V2.xlsx' del sitio de origen. ---
SOURCE_TENANT_ID=
SOURCE_CLIENT_ID=
SOURCE_CLIENT_SECRET=
SOURCE_GRAPH_TIMEOUT=120000
SOURCE_SHAREPOINT_HOSTNAME=fractaliagroup.sharepoint.com
SOURCE_SHAREPOINT_SITE_PATH=/sites/BPO
SOURCE_SHAREPOINT_FILE_PATH=Planificación y Control/Insumos/Chile/Ventas_Chile/FUNNEL VENTAS V2.xlsx

# --- Fecha watermark a procesar (equivalente a la variable de paquete
# User::Fecha de CROSS 0102 SSIS_CL_Ventas, formato YYYY-MM-DD). No usada por
# --paquete senalizaciones. Puede sobreescribirse puntualmente con --fecha. ---
VAR_FECHA=

# Tamano de lote para las inserciones (equivalente a ROWS_PER_BATCH del FastLoad).
BATCH_SIZE=5000
