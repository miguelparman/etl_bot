# --- Parametros/Variables declarados en CROSS 0102 SSIS_CL_Ventas.dtsx ---
# (se conserva la declaracion original del proyecto SSIS; ver PackageParameters
# en src/etl_chile/config/settings.py para el detalle de cada uno)

# Project Parameter "Periodo" (DT_I4). No se usa en ninguna consulta ni
# expresion del .dtsx original; se conserva por fidelidad. Valor de diseno
# original: 202505.
PARAM_PERIODO=202505

# Package Variable "User::Fecha" (DT_DATE). Fecha de corte usada por el
# pipeline de Ventas (equivalente a lo que el scheduler/proceso que invocaba
# el paquete original inyectaba via
# `dtexec /Set \Package.Variables[User::Fecha].Value=...`).
# Formato YYYY-MM-DD. Puede sobreescribirse puntualmente con --fecha en la CLI.
VAR_FECHA=2026-08-01

# Package Variable "User::Fec" (DT_I4). No se usa en ninguna parte del
# .dtsx original; se conserva por fidelidad. Valor de diseno original: 0.
VAR_FEC=0

LOG_LEVEL=INFO
