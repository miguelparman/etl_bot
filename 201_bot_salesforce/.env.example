# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" a ningun repositorio ni lo compartas por chat.

# ---------------------------------------------------------------------------
# Microsoft Entra ID / Graph (App Registration con permiso Sites.Selected,
# concedido unicamente al sitio ReportingFractalia)
# ---------------------------------------------------------------------------
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Salesforce (usuario/contrasena; el MFA se completa siempre manualmente)
# ---------------------------------------------------------------------------
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=

# ---------------------------------------------------------------------------
# SharePoint: resolucion por ruta. Deja los *_ID vacios la primera vez; una
# vez resueltos automaticamente, puedes copiarlos aqui para acelerar
# ejecuciones futuras (ver Fase 1, punto 9).
# ---------------------------------------------------------------------------
# Subcarpeta por defecto (dentro del site/biblioteca fijos ReportingFractalia
# / Data Reporting) para los informes que NO declaren su propia
# "sharepoint_folder_path" en config/reports.py. Deja vacio para usar el
# valor por defecto en app/config.py.
SHAREPOINT_FOLDER_PATH=

SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER_ID=

# ---------------------------------------------------------------------------
# Copia local/de red adicional de cada informe (ademas de SharePoint, no en
# su lugar). Deja vacio para usar el valor por defecto en app/config.py.
# ---------------------------------------------------------------------------
LOCAL_COPY_DIR=

# ---------------------------------------------------------------------------
# Comportamiento
# ---------------------------------------------------------------------------
# false para forzar navegador visible (necesario la primera vez o si
# Salesforce vuelve a pedir MFA). true para ejecucion desatendida.
HEADLESS=false

MAX_RETRIES=3
DELETE_LOCAL_AFTER_UPLOAD=true
OVERWRITE_EXISTING=true

# Limite temporal de informes a procesar durante pruebas (vacio o 0 = todos)
MAX_REPORTS=

# true = exporta y valida localmente, pero NO copia ni sube a ningun lado
DRY_RUN=false

# ---------------------------------------------------------------------------
# Timeouts, en MILISEGUNDOS
# ---------------------------------------------------------------------------
PAGE_TIMEOUT=60000
DOWNLOAD_TIMEOUT=120000
GRAPH_TIMEOUT=120000

# Este si es en MINUTOS: margen para completar login + MFA manualmente
MANUAL_LOGIN_TIMEOUT_MINUTES=10
