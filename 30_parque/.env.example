# Copiar a '.env' y completar con los valores reales. No versionar '.env'.

# --- SQL Server (destino, Connection Manager 'CL_PLANTA' en el .dtsx original) ---
DB_SERVER=172.17.0.162
DB_USER=mparedes
DB_PASSWORD=
DB_NAME=CL_PLANTA
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# ---------------------------------------------------------------------------
# Microsoft Entra ID / Graph (App Registration con permiso Sites.Selected,
# concedido UNICAMENTE al sitio ReportingFractalia). Reemplaza al Connection
# Manager OLE DB 'srv_chile' (Externos_Frac) del .dtsx original: el origen ya
# no es una tabla SQL Server, es el mismo archivo publicado como CSV en
# SharePoint.
# ---------------------------------------------------------------------------
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
GRAPH_TIMEOUT=120000

# --- SharePoint: sitio/biblioteca/carpeta donde se publican los CSV origen ---
SHAREPOINT_HOSTNAME=fractaliagroup.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/ReportingFractalia
SHAREPOINT_DRIVE_NAME=Data Reporting
SHAREPOINT_FOLDER_PATH=REPOSITORIOS DE CRUDOS/CHILE/BPOCHIPE/13 SERVIDOR CHILE

# --- Periodo a cargar (equivalente a la variable de paquete User::Periodo) ---
# El CSV origen puede traer varios periodos mezclados (a diferencia de la
# tabla SQL Server original, que ya llegaba filtrada por 'WHERE periodo = ?'):
# el pipeline filtra por este valor antes de truncar y cargar. Mismo formato
# que trae la columna 'periodo' del CSV (ej. 202607). Puede sobreescribirse
# puntualmente con --periodo en la CLI.
VAR_PERIODO=

# Tamano de lote para las inserciones (equivalente a ROWS_PER_BATCH del FastLoad).
BATCH_SIZE=5000
