# Copiar a '.env' y completar con los valores reales. No versionar '.env'.

# ANIO/MES se definen en el .env de la carpeta raíz del pipeline (compartido
# con bot_extraccion), no aquí. Ver Pipeline_Notas_de_credito/.env.example.
# Si se omiten ahí, se usa el mes/año actuales (o --anio/--mes).

# Conexión SQL Server (Connection Manager '162.CL_FACTURACION' en el .dtsx original).
DB_DRIVER={ODBC Driver 17 for SQL Server}
DB_SERVER=172.17.0.162
DB_DATABASE=CL_FACTURACION
DB_UID=
DB_PWD=
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# Excel de origen (Connection Manager 'NC' en el .dtsx original).
EXCEL_PATH=D:\OneDrive - IRISCENE ENGINEERING CORPORATION SLU\Insumos Chile\Informes\NC\DB\NC_.xlsx

# Tablas SQL Server.
TABLA_STAGING=[CL_FACTURACION].[dbo].[TBL_NC_Temp]
TABLA_DESTINO=[CL_FACTURACION].[dbo].[TBL_NC_DB]

# Tamaño de lote para las inserciones (equivalente a ROWS_PER_BATCH del FastLoad).
BATCH_SIZE=5000
