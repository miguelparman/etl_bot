# Copia este archivo a ".env" (junto a main.py) y ajusta lo que necesites.
# Cualquier variable que omitas usa el valor por defecto definido en el código.

# URL del informe de Power BI Service
REPORT_URL=https://app.powerbi.com/groups/me/reports/1288f632-29dc-4065-b5a9-55a3fe3a023f/ReportSection?experience=power-bi

# Nombre de la página del informe y de la tabla a exportar
REPORT_PAGE_NAME=RESUMEN II
TABLE_VISUAL_NAME=Detalle NC

# Ruta final donde se guarda (sobrescribiendo) el archivo exportado
DESTINO_FINAL=D:\OneDrive - IRISCENE ENGINEERING CORPORATION SLU\Insumos Chile\Informes\NC\DB\NC_.xlsx

# El filtro de año/mes (antes FILTRO_ANIO/FILTRO_MES_NC) ahora se define como
# ANIO/MES en el .env de la carpeta raíz del pipeline, compartido con
# etl_carga. Ver Pipeline_Notas_de_credito/.env.example.
# Dejar vacío en el .env raíz = no tocar ese filtro y usar el que traiga el informe.
FILTRO_PROVEEDOR=FRACTALIA PERU

# Modo de ejecución del navegador.
# HEADLESS=true (recomendado): corre en segundo plano. Si Power BI pide
#   iniciar sesión (perfil nuevo o sesión caducada), el script abre
#   automáticamente una ventana visible SOLO para ese paso, y vuelve a
#   headless en cuanto termines el login.
# HEADLESS=false: siempre visible (útil para depurar paso a paso con SLOW_MO).
HEADLESS=true
SLOW_MO=0

# Timeouts en milisegundos (ajustar si el tenant de Power BI va lento)
NAV_TIMEOUT=90000
VISUAL_TIMEOUT=60000
MENU_TIMEOUT=15000
DOWNLOAD_TIMEOUT=120000
LOGIN_POLL_TIMEOUT=300000
